# Copy to .env next to docker-compose.yml; compose reads it.

# Image tag: latest, or a release such as v1.0.0.
TAG=latest
IMAGE_PREFIX=docker.io/f3nici/fiscus

# Required: the HTTPS address you open Fiscus at.
FISCUS_BASE_URL=https://fiscus.example.com

# Passkey origin and domain, only if not those of FISCUS_BASE_URL.
FISCUS_ORIGIN=
FISCUS_RP_ID=

# Proxies allowed to set X-Forwarded-For (the Docker networks by default).
FISCUS_TRUSTED_PROXIES=172.16.0.0/12
# Where the container is published: this host only, so the reverse proxy
# reaches it and the network does not. 0.0.0.0 if the proxy is elsewhere.
FISCUS_HOST_BIND=127.0.0.1
# Host port the container is published on.
FISCUS_HOST_PORT=8000
# Decides what "today" is.
FISCUS_TIMEZONE=Australia/Perth

# Nightly backup: local hour, and days each is kept.
FISCUS_BACKUP_HOUR=2
FISCUS_BACKUP_RETENTION_DAYS=14

# Hours a recovery link, and the first-run link, stay valid.
FISCUS_SETUP_LINK_HOURS=48
FISCUS_BOOTSTRAP_HOURS=24
# Days a sign-in lasts unused, and at most.
FISCUS_SESSION_IDLE_DAYS=30
FISCUS_SESSION_ABSOLUTE_DAYS=90

# debug, info, warning or error.
FISCUS_LOG_LEVEL=info
