# Copy to .env before the first run. docker compose reads it automatically.

TAG=latest # Pin to a release tag once you have one, e.g. v1.0.0
IMAGE_PREFIX=docker.io/f3nici/fiscus

# REQUIRED. Generate with: openssl rand -hex 32
FISCUS_SECRET_KEY=

# REQUIRED. The HTTPS address of Fiscus behind your reverse proxy.
FISCUS_BASE_URL=https://fiscus.example.com

# Optional. Default to the origin and host of FISCUS_BASE_URL. Set RP_ID to a
# parent domain only if you know you need passkeys shared across subdomains.
# FISCUS_ORIGIN=https://fiscus.example.com
# FISCUS_RP_ID=fiscus.example.com

# The reverse proxy's address(es) as Fiscus sees them. X-Forwarded-For is only
# believed from these, which keeps rate limits and the audit log honest.
FISCUS_TRUSTED_PROXIES=172.16.0.0/12

FISCUS_HOST_PORT=8000
FISCUS_TIMEZONE=Australia/Perth
FISCUS_BACKUP_HOUR=2
FISCUS_BACKUP_RETENTION_DAYS=14
FISCUS_SETUP_LINK_HOURS=48
FISCUS_LOG_LEVEL=info # debug, info, warning or error
